{
  "meta": {
    "product": "ランニング習慣化アプリ Hashiru",
    "users": "運動を始めたいのに続かない20〜30代の運動初心者（toC・スマホ中心）",
    "primaryGoal": "低いハードルで走り始め、サボっても戻ってこられて、4週間続く",
    "device": "responsive",
    "stage": "MVP",
    "sources": [
      { "id": "src-um", "type": "um-spec", "path": "../uiux-model-users/examples/samples/running-habit.um-spec.json", "note": "ペルソナ（田村さやか）・ジャーニー（3日目の壁→再開）・インサイト・MVPストーリー" },
      { "id": "src-dir", "type": "instruction", "path": "(チャット指示)", "note": "toCサービスのサンプル。デザイン方針は未指定→提案" }
    ],
    "assumptions": [
      "IA入力なし：画面構成はストーリーマップのMVP骨格（始める→走る→続ける→振り返る）から導出（仮定）",
      "デザイン方針は未指定のため『前向きでやさしいエナジー』（コーラル系・大きめ角丸）を提案（仮定）",
      "ラン中は初心者向けにペース等の数値を出さない（インサイト『数値は中級者以降に効く』からの判断）"
    ]
  },

  "design": {
    "direction": "前向きでやさしいエナジー",
    "colors": {
      "primary": "#CC4420", "primaryText": "#FFFFFF",
      "bg": "#FFF8F4", "surface": "#FFFFFF",
      "text": "#2B2320", "textSub": "#7A6B62", "border": "#F3E5DC",
      "success": "#2FA57B", "warning": "#E09B2D", "danger": "#E0524D",
      "accent": "#FFD9CC"
    },
    "typography": {
      "family": "Noto Sans JP",
      "baseSize": "15px",
      "scale": { "xl": "26px", "lg": "18px", "md": "15px", "sm": "13px", "xs": "11px" }
    },
    "shape": { "radius": "16px", "density": "comfortable", "shadow": "0 2px 10px rgba(80,40,20,.07)" },
    "notes": ["主ボタンは大きく1画面1つ・角丸大（押すハードルを下げる）", "褒め・承認の文言を数値より先に置く", "警告色は使っても責める文言は使わない"],
    "source": "direction・配色・角丸は src-um のインサイト（低ハードル・承認・責めない）からの提案（仮定）。primary/textSub はコントラスト4.5:1確保のため調整済み",
    "components": [
      {
        "id": "cta-big",
        "name": "ビッグCTA",
        "usage": "1画面1つの主操作。大きく・やさしい文言で押すハードルを下げる（インサイト『低いハードル』）",
        "usedIn": ["onboarding", "home", "run", "done"],
        "html": "<button style=\"background:var(--c-primary);color:var(--c-primary-text);border:0;border-radius:var(--radius);padding:16px 34px;font-size:var(--fs-lg);font-weight:800;box-shadow:var(--shadow)\">5分ランを始める</button>"
      },
      {
        "id": "option-chip",
        "name": "選択チップ",
        "usage": "設定は入力させず選ばせる（インサイト『機能の多さは拒否シグナル』）。選択中はaccent塗り",
        "usedIn": ["onboarding"],
        "html": "<div style=\"display:flex;gap:8px\"><span style=\"background:var(--c-accent);border:1.5px solid var(--c-primary);border-radius:999px;padding:10px 16px;font-size:var(--fs-sm);font-weight:700\">5分でOK</span><span style=\"background:var(--c-surface);border:1.5px solid var(--c-border);border-radius:999px;padding:10px 16px;font-size:var(--fs-sm)\">10分</span></div>"
      },
      {
        "id": "stat-card",
        "name": "実績カード",
        "usage": "回数など『やった事実』のみ表示。ペース等の性能数値は初心者に出さない",
        "usedIn": ["home", "done"],
        "html": "<div style=\"background:var(--c-surface);border:1px solid var(--c-border);border-radius:var(--radius);padding:var(--space) 24px;text-align:center\"><div style=\"font-size:var(--fs-lg);font-weight:800\">2回</div><div style=\"font-size:var(--fs-xs);color:var(--c-text-sub);margin-top:2px\">今週走れた日</div></div>"
      },
      {
        "id": "encourage-banner",
        "name": "励ましバナー",
        "usage": "サボり復帰・承認の場面で使用。accent背景＋責めない文言（『それでいいんです』）",
        "usedIn": ["home"],
        "html": "<div style=\"width:100%;max-width:320px;background:var(--c-accent);border:1px solid var(--c-border);border-radius:var(--radius);padding:var(--space);text-align:center\"><div style=\"font-size:var(--fs-lg);font-weight:800\">3日ぶり。それでいいんです</div><div style=\"font-size:var(--fs-sm);color:var(--c-text-sub);margin-top:4px\">みんな途切れながら続けています</div></div>"
      },
      {
        "id": "guide-pill",
        "name": "音声ガイドピル",
        "usage": "ラン中の声かけ表示。丸ピル・穏やかなtextSubで（急かさない）",
        "usedIn": ["run"],
        "html": "<div style=\"background:var(--c-surface);border:1px solid var(--c-border);border-radius:999px;padding:10px 18px;font-size:var(--fs-sm);color:var(--c-text-sub);box-shadow:var(--shadow)\">🎧 いいペースです。歩いてもかまいませんよ</div>"
      },
      {
        "id": "praise-block",
        "name": "承認ブロック",
        "usage": "完了画面の主役。褒めを最上部・最大サイズで、記録値より先に置く（インサイト『承認は努力へ』）",
        "usedIn": ["done"],
        "html": "<div style=\"text-align:center\"><div style=\"width:56px;height:56px;margin:0 auto;border-radius:50%;background:var(--c-primary);color:var(--c-primary-text);font-size:26px;display:flex;align-items:center;justify-content:center\">🎉</div><div style=\"font-size:var(--fs-lg);font-weight:800;margin-top:10px\">今日も走れた。それがいちばんすごい</div></div>"
      }
    ]
  },

  "requirements": [
    "3つの質問だけで完了する初期目標設定",
    "5分から始められる音声ガイド付きラン",
    "ラン完了時に努力を承認（褒める）",
    "サボった後のやさしい復帰導線"
  ],

