# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# supabase local: keep the checked-in template, ignore real env files
!.env.example

# playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
/e2e/.auth/

# machine-local vendored shared libs for headless Chromium on WSL2 without
# root (see playwright.config.ts) — never committed, machine-specific binaries
/.playwright-libs/

# Agent toolkit runtime noise — the kit itself is installed locally, not vendored.
.claude/hooks/.logs/
**/__pycache__/
*.pyc

# Takumi kit: the kit itself is committed so the team shares the same agents,
# skills and rules. These three are per-machine state, not project content:
#   *.bak          — local backups the installer leaves when it rewrites settings
#   agent-memory/  — notes individual agents save for themselves across sessions
#   session-state/ — transient per-session scratch state
.claude/settings.json.*.bak
.claude/agent-memory/
.claude/session-state/
