/* Shared harness helpers: a real supabase-js client, real sessions, ground truth via psql. */
const { execFileSync } = require("child_process");
const { createClient } = require("/mnt/c/Users/nguyen.van.dungc/Desktop/project/my-app/node_modules/@supabase/supabase-js");

const URL = "http://127.0.0.1:54321";
const ANON =
  "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0";

function anonClient() {
  return createClient(URL, ANON, { auth: { persistSession: false, autoRefreshToken: false } });
}

async function signedUpClient(email, password) {
  const c = createClient(URL, ANON, { auth: { persistSession: false, autoRefreshToken: false } });
  const { data, error } = await c.auth.signUp({ email, password });
  if (error) throw new Error(`signUp failed: ${error.message}`);
  return { client: c, user: data.user };
}

function psql(sql) {
  return execFileSync(
    "docker",
    ["exec", "supabase_db_my-app", "psql", "-U", "postgres", "-X", "-q", "-A", "-t", "-c", sql],
    { encoding: "utf8" },
  ).trim();
}

let pass = 0;
let fail = 0;
function check(name, ok, detail) {
  if (ok) {
    pass++;
    console.log(`PASS  ${name}${detail ? `  — ${detail}` : ""}`);
  } else {
    fail++;
    console.log(`FAIL  ${name}${detail ? `  — ${detail}` : ""}`);
  }
}
function summary() {
  console.log(`\n${pass} passed, ${fail} failed`);
  process.exitCode = fail === 0 ? 0 : 1;
}

module.exports = { anonClient, signedUpClient, psql, check, summary };

