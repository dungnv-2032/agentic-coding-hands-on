--- check-mutate.js
--------------------------------------------------------------------------------
/* Phase 05 — measurements that REQUIRE mutation. `npx supabase db reset`
   restores the seed afterwards; the run prints the before/after row counts. */
const O = __dirname + "/out";
const { fetchKudosPage, fetchSentCount } = require(`${O}/lib/profile/profile-queries`);
const { getProfileData, buildFeedPage } = require(`${O}/lib/profile/profile-data`);
const { fetchProfileKudosPage } = require(`${O}/app/profile/_actions/fetch-profile-kudos-page`);
const { resolveViewer } = require(`${O}/lib/kudos/viewer`);
const { anonClient, signedUpClient, psql, check, summary } = require("./lib");

const ANON_VIEWER = { isAuthenticated: false, sunnerId: null, userId: null };
const TIE_AT = "2025-11-01 12:00:00+00";

async function pageAll(client, column, sunnerId, viewer, opts) {
  const pages = [];
  let cursor = null;
  for (let i = 0; i < 20; i++) {
    const rows = await fetchKudosPage(client, { column, sunnerId, cursor });
    const page = await buildFeedPage(client, rows, viewer, opts);
    pages.push(page);
    if (!page.hasMore) break;
    cursor = page.nextCursor;
  }
  return pages;
}

(async () => {
  const anon = anonClient();
  console.log(`before: ${psql("select count(*) from public.kudos;")} kudos rows, ${psql("select count(*) from auth.users;")} auth users`);

  // ======================================================================
  // M1 — the keyset TIE case. The seed has NO duplicate sent_at anywhere
  // (measured), so the degraded `sent_at.lt`-only predicate would pass
  // every seed-based assertion. 12 rows sharing one timestamp are inserted
  // deliberately, straddling the page-1 boundary.
  // ======================================================================
  psql(`insert into public.kudos (sender_id, receiver_id, campaign, message, sent_at, heart_baseline)
        select 1, 3, 'TIE', 'tie row ' || g, '${TIE_AT}'::timestamptz, 0 from generate_series(1, 12) g;`);
  console.log(`  inserted 12 rows at a single sent_at for receiver 3; receiver 3 now has ${psql("select count(*) from public.kudos where receiver_id = 3;")} rows`);
  console.log(`  ties: ${psql(`select count(*) from public.kudos where sent_at = '${TIE_AT}'::timestamptz;`)} rows share ${TIE_AT}`);

  const truth = psql("select string_agg(id::text, ',' order by sent_at desc, id desc) from public.kudos where receiver_id = 3;").split(",");
  const tiePages = await pageAll(anon, "receiver_id", 3, ANON_VIEWER, {});
  const tieIds = tiePages.flatMap((p) => p.cards.map((c) => c.id));
  tiePages.forEach((p, i) => console.log(`  page ${i + 1}: ${p.cards.map((c) => c.id).join(",")}  hasMore=${p.hasMore} nextCursor=${JSON.stringify(p.nextCursor)}`));
  check("M1a all 13 rows come back across the pages", tieIds.length === truth.length, `${tieIds.length} vs ${truth.length}`);
  check("M1b no duplicate across the tie boundary", new Set(tieIds).size === tieIds.length);
  check("M1c order identical to the SQL row-comparison ground truth", tieIds.join(",") === truth.join(","),
    `got ${tieIds.join(",")}`);
  check("M1d page 1's last row and page 2's first row SHARE a sent_at (the boundary is really a tie)",
    psql(`select (select sent_at from public.kudos where id = ${tiePages[0].cards[9].id}) = (select sent_at from public.kudos where id = ${tiePages[1].cards[0].id});`) === "t",
    `${tiePages[0].cards[9].id} | ${tiePages[1].cards[0].id}`);

  // The degraded form the phase file warns about, run on the same data.
  const c = tiePages[0].nextCursor;
  const { data: degraded } = await anon
    .from("kudos_readable").select("id, sent_at").eq("receiver_id", 3)
    .lt("sent_at", c.sentAt)
    .order("sent_at", { ascending: false }).order("id", { ascending: false }).limit(11);
  check("M1e the degraded `sent_at.lt`-only predicate DOES drop the tied rows",
    degraded.length < tiePages[1].cards.length,
    `sent_at.lt alone returns ${degraded.length} rows where the correct predicate returns ${tiePages[1].cards.length}: ids ${degraded.map((r) => r.id).join(",") || "(none)"}`);

  psql(`delete from public.kudos where campaign = 'TIE';`);
  console.log(`  tie rows removed; kudos count back to ${psql("select count(*) from public.kudos;")}`);

  // ======================================================================
  // M2 — the SELF face with real numbers: link a real session to sunner 1.
  // ======================================================================
  const { client: self1, user: u1 } = await signedUpClient(`phase05-self-${Date.now()}@example.com`, "phase05-password");
  psql(`update public.sunners set auth_user_id = '${u1.id}' where id = 1;`);
  const viewer1 = await resolveViewer(self1);
  check("M2a resolveViewer sees the linked sunners row", viewer1.sunnerId === 1 && viewer1.isAuthenticated === true,
    JSON.stringify({ sunnerId: viewer1.sunnerId }));
  const mine = await getProfileData(self1, 1, viewer1);
  const m = mine.model;
  console.log(`  self model: isSelf=${m.isSelf} stats=${JSON.stringify(m.stats)} counts=${JSON.stringify(m.counts)} writeKudoTargetId=${m.writeKudoTargetId}`);
  const truthSelf = psql(`select s.kudos_received_baseline + (select count(*) from public.kudos where receiver_id = 1),
                                 (select count(*) from public.kudos where sender_id = 1),
                                 (select sum(k.heart_baseline + (select count(*) from public.kudos_likes l where l.kudos_id = k.id)) from public.kudos k where k.receiver_id = 1),
                                 s.secret_box_opened_count, s.secret_box_unopened_count
                          from public.sunners s where s.id = 1;`).split("|").map(Number);
  check("M2b stats non-null iff isSelf, and every number matches SQL",
    m.isSelf === true && m.stats !== null &&
    m.stats.kudosReceived === truthSelf[0] && m.stats.kudosSent === truthSelf[1] &&
    m.stats.heartsReceived === truthSelf[2] && m.stats.secretBoxOpened === truthSelf[3] &&
    m.stats.secretBoxUnopened === truthSelf[4],
    `SQL truth ${truthSelf.join("/")}`);
  check("M2c counts.sent non-null on the self face, writeKudoTargetId null",
    m.counts.sent === truthSelf[1] && m.writeKudoTargetId === null);
  check("M2d Secret Box reads the real columns (25/25 for the frame viewer, not a literal)",
    m.stats.secretBoxOpened === 25 && m.stats.secretBoxUnopened === 25);
  check("M2e no auth uuid or email anywhere in the self model",
    !JSON.stringify(m).includes(u1.id) && !JSON.stringify(m).includes("@"));

  // ======================================================================
  // M3/M4/M5 — SEC_002: a real session composes a real anonymous Kudo
  // through F005's write path, then reads its own Sent list.
  // ======================================================================
  const email = `phase05-sec002-${Date.now()}@example.com`;
  const { client: author, user: ua } = await signedUpClient(email, "phase05-password");
  const hashtagId = Number(psql("select id from public.hashtags order by position limit 1;"));
  const { data: newKudosId, error: rpcError } = await author.rpc("create_kudos", {
    p_receiver_id: 1, p_campaign: "IDOL GIỚI TRẺ", p_message: "phase 05 SEC_002 probe",
    p_message_format: "plain", p_is_anonymous: true, p_anonymous_name: null,
    p_hashtag_ids: [hashtagId], p_image_urls: [],
  });
  if (rpcError) throw new Error(`create_kudos failed: ${rpcError.message}`);
  const authorViewer = await resolveViewer(author);
  console.log(`  composed kudos ${newKudosId} anonymously; author provisioned as sunner ${authorViewer.sunnerId}`);
  check("M3a create_kudos provisioned a sunners row for the author (write path, not this layer)",
    authorViewer.sunnerId !== null);

  global.__HARNESS_CLIENT__ = author;
  const sentPage = await fetchProfileKudosPage({ targetSunnerId: null, direction: "sent", cursor: null });
  const ownCard = sentPage.cards.find((x) => x.id === newKudosId);
  console.log(`  own Sent list: ${sentPage.cards.length} card(s) — ${JSON.stringify(ownCard && { id: ownCard.id, sender: ownCard.sender, anonymousSenderLabel: ownCard.anonymousSenderLabel, sentAnonymously: ownCard.sentAnonymously, canLike: ownCard.canLike, isOwnedByViewer: ownCard.isOwnedByViewer })}`);
  check("M3b SEC_002 — the viewer's OWN anonymous Kudo IS in their own Sent list", ownCard !== undefined);
  check("M3c it names the viewer as the author, not the masked alias",
    ownCard.sender.id === authorViewer.sunnerId && ownCard.anonymousSenderLabel === null &&
    ownCard.sender.fullName === email.split("@")[0],
    `sender ${JSON.stringify(ownCard.sender.fullName)} / label ${JSON.stringify(ownCard.anonymousSenderLabel)}`);
  check("M3d and is still marked as sent anonymously (FR-602, rendered by nothing)",
    ownCard.sentAnonymously === true);
  check("M3e the author still cannot heart their own Kudo (BR-003 survives the reveal)",
    ownCard.canLike === false && ownCard.isOwnedByViewer === true);

  // The same row, same read path, seen by everybody else.
  const rec = await pageAll(anon, "receiver_id", 1, ANON_VIEWER, {});
  const masked = rec.flatMap((p) => p.cards).find((x) => x.id === newKudosId);
  console.log(`  same kudos in receiver 1's feed as an anonymous visitor: ${JSON.stringify(masked && { id: masked.id, sender: masked.sender, anonymousSenderLabel: masked.anonymousSenderLabel })}`);
  check("M3f the SAME row is masked for everybody else, through the same code",
    masked !== undefined && masked.sender.id === 0 && masked.anonymousSenderLabel === "Ẩn danh" &&
    !JSON.stringify(masked).includes(email.split("@")[0]),
    `author local-part "${email.split("@")[0]}" absent from the masked card`);
  check("M3g revealOwnAnonymous off (the Received face) keeps the mask even for the author",
    (await (async () => {
      const rows = await fetchKudosPage(author, { column: "receiver_id", sunnerId: 1, cursor: null });
      const p = await buildFeedPage(author, rows, authorViewer);
      const own = p.cards.concat((await buildFeedPage(author, await fetchKudosPage(author, { column: "receiver_id", sunnerId: 1, cursor: p.nextCursor }), authorViewer)).cards).find((x) => x.id === newKudosId);
      return own !== undefined && own.anonymousSenderLabel === "Ẩn danh" && own.sender.id === 0;
    })()),
    "board/Received parity — only the Sent list reveals");

  // M4 — the caller's own sent count INCLUDES the anonymous one.
  const ownSent = await fetchSentCount(author, authorViewer.sunnerId);
  const ownSentTruth = Number(psql(`select count(*) from public.kudos where sender_id = ${authorViewer.sunnerId};`));
  check("M4 the caller's own sent count includes their anonymous send (counter/list parity)",
    ownSent === ownSentTruth && ownSent === sentPage.cards.length,
    `count ${ownSent}, SQL ${ownSentTruth}, cards ${sentPage.cards.length}`);

  // M5 — badge null at zero received, on the auto-provisioned sunner.
  const fresh = await getProfileData(author, authorViewer.sunnerId, authorViewer);
  console.log(`  auto-provisioned sunner profile: ${JSON.stringify({ hero: fresh.model.hero, counts: fresh.model.counts })}`);
  check("M5 badge is NULL at 0 received (not the 'New Hero' badgeTierFor(0) returns)",
    fresh.model.counts.received === 0 && fresh.model.hero.badge === null && fresh.model.hero.badgeTooltip === null);
  check("M5b the auto-provisioned department is carried through, not nulled",
    fresh.model.hero.department === "Unassigned", String(fresh.model.hero.department));

  // M6 — SC-003 again, now with a caller who HAS sent Kudos: two different
  // targetSunnerId values must still return the caller's own list.
  const a = await fetchProfileKudosPage({ targetSunnerId: 1, direction: "sent", cursor: null });
  const b = await fetchProfileKudosPage({ targetSunnerId: 2, direction: "sent", cursor: null });
  const d = await fetchProfileKudosPage({ targetSunnerId: 999999, direction: "sent", cursor: null });
  check("M6 SC-003 with a non-empty Sent list — targetSunnerId changes nothing",
    JSON.stringify(a) === JSON.stringify(b) && JSON.stringify(b) === JSON.stringify(d) &&
    a.cards.length === 1 && a.cards[0].id === newKudosId,
    `all three return the caller's own ${a.cards.length} card(s): id ${a.cards[0].id}`);

  console.log(`after: ${psql("select count(*) from public.kudos;")} kudos rows, ${psql("select count(*) from auth.users;")} auth users — restored by the db reset that follows`);
  summary();
})().catch((e) => {
  console.error("HARNESS CRASHED:", e);
  process.exitCode = 1;
});

