/* Phase 05 — measurements that need NO mutation. Seed state only. */
const O = __dirname + "/out";
const { fetchKudosPage, fetchProfileSunner, fetchReceivedAggregate, fetchSentCount,
        fetchReceivedCounts, isValidFeedCursor } = require(`${O}/lib/profile/profile-queries`);
const { getProfileData, buildFeedPage, emptyFeedPage } = require(`${O}/lib/profile/profile-data`);
const { fetchProfileKudosPage } = require(`${O}/app/profile/_actions/fetch-profile-kudos-page`);
const { anonClient, signedUpClient, psql, check, summary } = require("./lib");

const ANON_VIEWER = { isAuthenticated: false, sunnerId: null, userId: null };

async function pageAll(client, column, sunnerId, viewer, opts) {
  const pages = [];
  let cursor = null;
  for (let i = 0; i < 20; i++) {
    const rows = await fetchKudosPage(client, { column, sunnerId, cursor });
    const page = await buildFeedPage(client, rows, viewer, opts);
    pages.push(page);
    if (!page.hasMore) break;
    cursor = page.nextCursor;
  }
  return pages;
}

(async () => {
  const anon = anonClient();

  // ---- ground truth from the base table, as superuser -------------------
  const truthIds = psql(
    "select string_agg(id::text, ',' order by sent_at desc, id desc) from public.kudos where receiver_id = 1;",
  ).split(",");
  const truthCount = Number(psql("select count(*) from public.kudos where receiver_id = 1;"));
  const truthHearts = Number(
    psql(`select sum(k.heart_baseline + (select count(*) from public.kudos_likes l where l.kudos_id = k.id))
          from public.kudos k where k.receiver_id = 1;`),
  );
  console.log(`ground truth: receiver 1 has ${truthCount} rows, hearts ${truthHearts}`);
  console.log(`ground truth id order: ${truthIds.join(",")}`);

  // ---- K1 keyset paging --------------------------------------------------
  const pages = await pageAll(anon, "receiver_id", 1, ANON_VIEWER, {});
  const ids = pages.flatMap((p) => p.cards.map((c) => c.id));
  pages.forEach((p, i) =>
    console.log(`  page ${i + 1}: ${p.cards.length} cards, hasMore=${p.hasMore}, nextCursor=${JSON.stringify(p.nextCursor)}`),
  );
  console.log(`  page ids: ${pages.map((p) => p.cards.map((c) => c.id).join("|")).join("  ||  ")}`);
  check("K1a page sizes are 10/10/6", JSON.stringify(pages.map((p) => p.cards.length)) === "[10,10,6]",
    JSON.stringify(pages.map((p) => p.cards.length)));
  check("K1b union has no duplicate", new Set(ids).size === ids.length, `${ids.length} rows, ${new Set(ids).size} distinct`);
  check("K1c union skips nothing", ids.length === truthCount, `${ids.length} vs ${truthCount}`);
  check("K1d order identical to SQL row-comparison ground truth", ids.join(",") === truthIds.join(","));
  check("K1e last page hasMore=false and nextCursor=null",
    pages[pages.length - 1].hasMore === false && pages[pages.length - 1].nextCursor === null);
  check("K1f boundary: last id of page 1 != first id of page 2",
    pages[0].cards[9].id !== pages[1].cards[0].id,
    `${pages[0].cards[9].id} then ${pages[1].cards[0].id}`);

  // ---- K2 the extra row never reaches the client -------------------------
  const raw = await fetchKudosPage(anon, { column: "receiver_id", sunnerId: 1, cursor: null });
  check("K2 reads FEED_PAGE_SIZE+1 rows, returns 10", raw.length === 11 && pages[0].cards.length === 10,
    `raw ${raw.length} → cards ${pages[0].cards.length}`);

  // ---- K3 anonymity through THIS read path ------------------------------
  // The real sender of kudos 58 is sunner 2, "Huỳnh Dương Xuân" — a strict
  // PREFIX of the receiver's own name, "Huỳnh Dương Xuân Nhật", which is on
  // all 26 cards. So a substring scan of the payload cannot decide this; the
  // sender's DISTINCTIVE facts are checked field by field on the card itself.
  const [senderId, senderName, senderBaseline, senderDept] = psql(
    `select s.id, s.full_name, s.kudos_received_baseline,
            (select d.name from public.departments d where d.id = s.department_id)
     from public.sunners s where s.id = (select sender_id from public.kudos where id = 58);`,
  ).split("|");
  const allCards = pages.flatMap((p) => p.cards);
  const anonCard = allCards.find((c) => c.id === 58);
  check("K3a the seeded anonymous kudo IS in the received feed", anonCard !== undefined);
  check("K3b its sender is the redacted stub", anonCard.sender.id === 0 && anonCard.anonymousSenderLabel === "Ẩn danh",
    JSON.stringify(anonCard.sender));
  check("K3c the real sender's id/department/tier are absent from that card",
    anonCard.sender.id !== Number(senderId) &&
    anonCard.sender.department === "" && anonCard.sender.department !== senderDept &&
    anonCard.sender.badge !== "Legend Hero" && anonCard.sender.badgeTooltip === null,
    `real sender = ${senderId}|${senderName}|baseline ${senderBaseline} (Legend Hero)|${senderDept}`);
  // Sunner 2 is also the OPEN sender of four of these 26 rows, so they must
  // still appear by name there — the guarantee is per-row, not per-person.
  const openFromSender = allCards.filter((c) => !c.sentAnonymously && c.sender.id === Number(senderId));
  check("K3d no ANONYMOUS card names the real sender, while their open sends still do",
    allCards.every((c) => !c.sentAnonymously || (c.sender.id !== Number(senderId) && c.sender.fullName !== senderName)) &&
    openFromSender.length > 0,
    `${allCards.length} cards, ${openFromSender.length} open sends by sunner ${senderId} shown by name, 1 anonymous one masked`);
  check("K3e exactly one masked card across all three pages",
    allCards.filter((c) => c.anonymousSenderLabel !== null).length === 1);
  check("K3f sentAnonymously true on exactly that one card",
    allCards.filter((c) => c.sentAnonymously).length === 1 && anonCard.sentAnonymously === true);

  // ---- K4 aggregates / sunner read --------------------------------------
  const sunner = await fetchProfileSunner(anon, 1);
  check("K4a fetchProfileSunner selects only allowed columns",
    JSON.stringify(Object.keys(sunner).sort()) ===
      JSON.stringify(["avatar_url", "department", "full_name", "id", "kudos_received_baseline",
        "secret_box_opened_count", "secret_box_unopened_count"]),
    JSON.stringify(Object.keys(sunner).sort()));
  check("K4b unknown sunner returns null, not a throw", (await fetchProfileSunner(anon, 999999)) === null);
  const agg = await fetchReceivedAggregate(anon, 1);
  check("K4c received aggregate matches SQL", agg.count === truthCount && agg.hearts === truthHearts,
    JSON.stringify(agg));
  // Read as an ANONYMOUS caller on purpose: the view masks sunner 2's own
  // anonymous send, so the count comes back one short of the truth. That is
  // SEC_001/SEC_002 working — somebody else's anonymous sends cannot even be
  // COUNTED through the view. `getProfileData` only ever calls this for the
  // caller's own id, where the view reveals them; the complete-count case is
  // check M4 in the mutating run.
  const trueSent = Number(psql("select count(*) from public.kudos where sender_id = 2;"));
  const anonSeesSent = await fetchSentCount(anon, 2);
  check("K4d another Sunner's anonymous send is not even countable through the view",
    trueSent === 12 && anonSeesSent === 11, `truth ${trueSent}, anon sees ${anonSeesSent}`);
  const counts = await fetchReceivedCounts(anon, [1, 2, 3]);
  check("K4e received-count map matches SQL for the page's sunners",
    counts.get(1) === 26 && counts.get(2) === 25, JSON.stringify([...counts]));
  check("K4f empty id list issues no query and returns an empty map",
    (await fetchReceivedCounts(anon, [])).size === 0);

  // ---- K5 badge tier parity with the board ------------------------------
  const card26 = pages[0].cards[0];
  check("K5 sender badge tier uses the full received count, not the page's",
    card26.receiver.badge === "Super Hero", `receiver badge ${card26.receiver.badge} (26 received)`);

  // ---- K6 getProfileData, other Sunner's face ---------------------------
  const other = await getProfileData(anon, 1, ANON_VIEWER);
  check("K6a found sentinel", other.kind === "found");
  const m = other.model;
  console.log(`  model: ${JSON.stringify({ ...m, initialPage: { n: m.initialPage.cards.length, hasMore: m.initialPage.hasMore, nextCursor: m.initialPage.nextCursor } })}`);
  check("K6b isSelf false, stats null, counts.sent null, writeKudoTargetId 1",
    m.isSelf === false && m.stats === null && m.counts.sent === null && m.writeKudoTargetId === 1);
  check("K6c counts.received = baseline + rows", m.counts.received === 26, String(m.counts.received));
  check("K6d hero badge from badgeTierFor(26)", m.hero.badge === "Super Hero" && m.hero.badgeTooltip !== null);
  check("K6e hero carries department and avatar", m.hero.department !== null && m.hero.avatarUrl.length > 0,
    `${m.hero.fullName} / ${m.hero.department}`);
  check("K6f initialPage is page 1 of RECEIVED", m.initialPage.cards.length === 10 && m.initialPage.hasMore === true);
  check("K6g unknown target → not-found sentinel", (await getProfileData(anon, 999999, ANON_VIEWER)).kind === "not-found");
  // Every one of the nine seeded sunners has at least one received Kudo
  // (measured), so the `badge === null` branch has no seed subject at all —
  // it is check M5 in the mutating run, on the auto-provisioned sunner.
  const low = await getProfileData(anon, 3, ANON_VIEWER);
  check("K6h lowest seeded received count still gets the lowest tier, not null",
    low.model.counts.received === 1 && low.model.hero.badge === "New Hero",
    `sunner 3 received = ${low.model.counts.received}, badge ${low.model.hero.badge}`);

  // ---- K7 sparse self view (real signed-up user, no sunners row) --------
  const email = `phase05-${Date.now()}@example.com`;
  const { client: authed, user } = await signedUpClient(email, "phase05-password");
  const viewer = { isAuthenticated: true, sunnerId: null, userId: user.id };
  const sparse = await getProfileData(authed, null, viewer);
  check("K7a sparse self is 'found'", sparse.kind === "found");
  const s = sparse.model;
  console.log(`  sparse model: ${JSON.stringify(s)}`);
  check("K7b name is the email LOCAL-PART, never the address",
    s.hero.fullName === email.split("@")[0] && !JSON.stringify(s).includes("@"),
    s.hero.fullName);
  check("K7c avatar is the sample fallback", s.hero.avatarUrl === "/images/kudos/sample-avatar.png");
  check("K7d department null, badge null, sunnerId null",
    s.hero.department === null && s.hero.badge === null && s.hero.badgeTooltip === null && s.hero.sunnerId === null);
  check("K7e isSelf true, writeKudoTargetId null, stats all zero, counts 0/0",
    s.isSelf === true && s.writeKudoTargetId === null && s.stats !== null &&
    Object.values(s.stats).every((v) => v === 0) && s.counts.received === 0 && s.counts.sent === 0);
  check("K7f initialPage empty", s.initialPage.cards.length === 0 && s.initialPage.hasMore === false && s.initialPage.nextCursor === null);
  check("K7g NO sunners row was provisioned by the read",
    psql(`select count(*) from public.sunners where auth_user_id = '${user.id}';`) === "0");
  check("K7h no auth uuid in the model", !JSON.stringify(s).includes(user.id));

  // ---- K8 the server action -------------------------------------------
  global.__HARNESS_CLIENT__ = authed;
  const p1 = await fetchProfileKudosPage({ targetSunnerId: 1, direction: "received", cursor: null });
  check("K8a action, received, page 1", p1.cards.length === 10 && p1.hasMore === true);
  const p2 = await fetchProfileKudosPage({ targetSunnerId: 1, direction: "received", cursor: p1.nextCursor });
  check("K8b action page 2 does not repeat page 1",
    p2.cards.every((c) => !p1.cards.some((x) => x.id === c.id)),
    `${p1.cards.map((c) => c.id).join(",")} then ${p2.cards.map((c) => c.id).join(",")}`);
  const sentA = await fetchProfileKudosPage({ targetSunnerId: 1, direction: "sent", cursor: null });
  const sentB = await fetchProfileKudosPage({ targetSunnerId: 2, direction: "sent", cursor: null });
  check("K8c SC-003 — two different targetSunnerId, identical 'sent' payload",
    JSON.stringify(sentA) === JSON.stringify(sentB), JSON.stringify(sentA));
  check("K8d sent + callerSunnerId null → empty page, no error",
    sentA.cards.length === 0 && sentA.hasMore === false && sentA.nextCursor === null);
  for (const bad of [
    { targetSunnerId: 1, direction: "SENT", cursor: null },
    { targetSunnerId: 1, direction: "received", cursor: { sentAt: "2025-10-23T15:00:00+00:00,id.gt.0)", id: 26 } },
    { targetSunnerId: 1, direction: "received", cursor: { sentAt: "banana", id: 26 } },
    { targetSunnerId: 1, direction: "received", cursor: { sentAt: "2025-10-23T15:00:00+00:00", id: 1.5 } },
    { targetSunnerId: 1.5, direction: "received", cursor: null },
    { targetSunnerId: null, direction: "received", cursor: null },
  ]) {
    const r = await fetchProfileKudosPage(bad);
    check(`K8e malformed input → empty page: ${JSON.stringify(bad)}`,
      r.cards.length === 0 && r.hasMore === false && r.nextCursor === null);
  }
  check("K8f isValidFeedCursor rejects a filter-injection payload",
    isValidFeedCursor({ sentAt: "2025-10-23T15:00:00+00:00", id: 26 }) === true &&
    isValidFeedCursor({ sentAt: "2025-10-23T15:00:00+00:00,x)", id: 26 }) === false &&
    isValidFeedCursor({ sentAt: '2025-10-23T15:00:00+00:00"', id: 26 }) === false &&
    isValidFeedCursor(null) === false && isValidFeedCursor({ id: 1 }) === false);
  check("K8g emptyFeedPage is a fresh object each call", emptyFeedPage() !== emptyFeedPage());

  summary();
})().catch((e) => {
  console.error("HARNESS CRASHED:", e);
  process.exitCode = 1;
});

