# Supabase local development stack.
# Start it with:  npx supabase start
# Then copy the printed values here into .env.local (which is gitignored).
#
# "API URL" from `npx supabase status` — matches [api] port in supabase/config.toml.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# The "Publishable" key from `npx supabase status` (new sb_publishable_... format).
# This key is safe to expose to the browser; it is bounded by Row Level Security.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The service_role key is NOT listed here on purpose. It bypasses Row Level
# Security, so it must never be exposed to the browser or committed.

# Origin used to build the OAuth `redirectTo` URL. Must match `site_url` and
# one of the entries in `additional_redirect_urls` in supabase/config.toml
# exactly, or Supabase will reject the redirect.
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000

# Google OAuth client credentials read by the Supabase CLI's env(...)
# substitution in supabase/config.toml ([auth.external.google]). These belong
# in the repo-root .env file (gitignored, read by the Supabase CLI at
# `supabase start` time) — NOT in .env.local, which only the Next.js app reads.
#   SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=<your-client-id>.apps.googleusercontent.com
#   SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=<your-client-secret>
